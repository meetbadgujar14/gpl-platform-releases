  "cross_domain_refs": [],
  "kpi_definitions": [
    {
      "name": "supplier_on_time_delivery_rate",
      "description": "Percentage of supplier deliveries that arrived on time, reflecting supplier reliability.",
      "formula": "{supply_chain_supplier_performance_on_time_delivery_rate_percent} / {supply_chain_supplier_performance_count}",
      "unit": "percent",
      "depends_on": [
        "supply_chain_supplier_performance_on_time_delivery_rate_percent",
        "supply_chain_supplier_performance_count"
      ]
    },
    {
      "name": "inventory_turnover_ratio",
      "description": "Ratio of cost of goods sold to average inventory on hand, indicating how efficiently inventory is being used.",
      "formula": "{supply_chain_financials_cost_of_goods_sold_currency} / {supply_chain_inventory_levels_quantity_on_hand_count}",
      "unit": "ratio",
      "depends_on": [
        "supply_chain_financials_cost_of_goods_sold_currency",
        "supply_chain_inventory_levels_quantity_on_hand_count"
      ]
    },
    {
      "name": "purchase_order_fulfillment_rate",
      "description": "Proportion of ordered quantities that have been received, measuring procurement completion effectiveness.",
      "formula": "{supply_chain_purchase_order_lines_quantity_received_count} / {supply_chain_purchase_order_lines_quantity_ordered_count}",
      "unit": "percent",
      "depends_on": [
        "supply_chain_purchase_order_lines_quantity_received_count",
        "supply_chain_purchase_order_lines_quantity_ordered_count"
      ]
    },
    {
      "name": "freight_cost_per_kg",
      "description": "Average freight cost incurred per kilogram shipped, used to benchmark carrier cost efficiency.",
      "formula": "{supply_chain_shipments_freight_cost_currency} / {supply_chain_shipments_total_weight_kg_currency}",
      "unit": "currency",
      "depends_on": [
        "supply_chain_shipments_freight_cost_currency",
        "supply_chain_shipments_total_weight_kg_currency"
      ]
    },
