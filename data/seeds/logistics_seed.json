  "kpi_definitions": [
    {
      "name": "freight_cost_per_km",
      "description": "Average freight cost incurred per kilometer across all shipments.",
      "formula": "{logistics_shipments_freight_cost_currency} / {logistics_freight_orders_distance_km_count}",
      "unit": "currency",
      "depends_on": [
        "logistics_shipments_freight_cost_currency",
        "logistics_freight_orders_distance_km_count"
      ]
    },
    {
      "name": "on_time_delivery_rate",
      "description": "Proportion of shipments delivered without delay out of all completed shipments.",
      "formula": "{logistics_shipments_count_delivered} / ({logistics_shipments_count_delivered} + {logistics_shipments_count_delayed})",
      "unit": "percent",
      "depends_on": [
        "logistics_shipments_count_delivered",
        "logistics_shipments_count_delayed"
      ]
    },
    {
      "name": "fuel_efficiency_km_per_litre",
      "description": "Average kilometers traveled per litre of fuel consumed across all vehicle trips.",
      "formula": "{logistics_fuel_consumption_distance_km_count} / {logistics_fuel_consumption_litres_consumed_count}",
      "unit": "ratio",
      "depends_on": [
        "logistics_fuel_consumption_distance_km_count",
        "logistics_fuel_consumption_litres_consumed_count"
      ]
    },
    {
      "name": "customs_clearance_success_rate",
      "description": "Percentage of customs declarations that were successfully cleared out of all declarations.",
      "formula": "{logistics_customs_declarations_count_cleared} / {logistics_customs_declarations_count}",
      "unit": "percent",
      "depends_on": [
        "logistics_customs_declarations_count_cleared",
        "logistics_customs_declarations_count"
      ]
    },
    {
      "name": "freight_order_cost_variance_rate",
      "description": "Ratio of actual freight order cost to agreed cost, indicating budget adherence.",
      "formula": "{logistics_freight_orders_actual_cost_currency} / {logistics_freight_orders_agreed_cost_currency}",
      "unit": "ratio",
      "depends_on": [
        "logistics_freight_orders_actual_cost_currency",
        "logistics_freight_orders_agreed_cost_currency"
      ]
    }
  ],
